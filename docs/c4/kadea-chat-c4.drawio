ometry"/></mxCell><mxCell id="k76" value="table avatars&lt;br&gt;&lt;span style='font-size:10px'&gt;[SQL]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k57" target="k59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k77" value="envoie les e-mails&lt;br&gt;&lt;span style='font-size:10px'&gt;[API HTTPS]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k53" target="k60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k78" value="&lt;b&gt;Légende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B1D29;" vertex="1" parent="1"><mxGeometry x="1420" y="420" width="200" height="20" as="geometry"/></mxCell><mxCell id="k79" value="Personne" style="rounded=1;arcSize=20;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="444" width="190" height="22" as="geometry"/></mxCell><mxCell id="k80" value="Système étudié" style="rounded=1;arcSize=20;html=1;fillColor=#F2A541;fontColor=#1B1D29;strokeColor=#C9822A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="190" height="22" as="geometry"/></mxCell><mxCell id="k81" value="Conteneur" style="rounded=1;arcSize=20;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="496" width="190" height="22" as="geometry"/></mxCell><mxCell id="k82" value="Composant" style="rounded=1;arcSize=20;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;fontSize=