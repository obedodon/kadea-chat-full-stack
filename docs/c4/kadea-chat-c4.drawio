<mxfile host="app.diagrams.net" agent="Kadea Chat C4" version="24.7.17"><diagram id="k18" name="1. Contexte"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k2" value="Kadea Chat — Niveau 1 : diagramme de contexte" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1B1D29;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="32" as="geometry"/></mxCell><mxCell id="k3" value="Qui utilise Kadea Chat, et avec quels systèmes extérieurs l'application échange." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6075;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="40" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b style='font-size:15px'&gt;Apprenant de Kadea Academy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Personne]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Membre de la communauté Kadea : discute en privé et en groupe avec sa promo.&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="320" height="170" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b style='font-size:15px'&gt;Kadea Chat&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Système logiciel]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Messagerie web en temps réel : comptes confirmés par e-mail, discussions privées et groupes, photos, accusés de lecture, blocage.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2A541;fontColor=#1B1D29;strokeColor=#C9822A;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="470" width="400" height="200" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b style='font-size:15px'&gt;Brevo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Système externe]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Service d'envoi d'e-mails transactionnels, appelé par son API.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="480" width="320" height="180" as="geometry"/></mxCell><mxCell id="k7" value="&lt;b style='font-size:15px'&gt;Boîte mail de l'utilisateur&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Système externe]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Gmail, Outlook… Reçoit les liens de confirmation et de réinitialisation.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="320" height="170" as="geometry"/></mxCell><mxCell id="k8" value="Crée son compte, écrit et lit ses messages, gère son profil et ses groupes&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k4" target="k5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k9" value="Demande l'envoi des e-mails&lt;br&gt;&lt;span style='font-size:10px'&gt;[API HTTPS]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k10" value="Délivre les e-mails&lt;br&gt;&lt;span style='font-size:10px'&gt;[SMTP]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k6" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k11" value="Ouvre les liens reçus" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k4" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k12" value="&lt;b&gt;Légende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B1D29;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="200" height="20" as="geometry"/></mxCell><mxCell id="k13" value="Personne" style="rounded=1;arcSize=20;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="724" width="190" height="22" as="geometry"/></mxCell><mxCell id="k14" value="Système étudié" style="rounded=1;arcSize=20;html=1;fillColor=#F2A541;fontColor=#1B1D29;strokeColor=#C9822A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="190" height="22" as="geometry"/></mxCell><mxCell id="k15" value="Conteneur" style="rounded=1;arcSize=20;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="190" height="22" as="geometry"/></mxCell><mxCell id="k16" value="Composant" style="rounded=1;arcSize=20;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="802" width="190" height="22" as="geometry"/></mxCell><mxCell id="k17" value="Externe" style="rounded=1;arcSize=20;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="828" width="190" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k41" name="2. Conteneurs"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k19" value="Kadea Chat — Niveau 2 : diagramme de conteneurs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1B1D29;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="32" as="geometry"/></mxCell><mxCell id="k20" value="Les éléments qui s'exécutent séparément, et la façon dont ils communiquent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6075;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="40" as="geometry"/></mxCell><mxCell id="k21" value="Kadea Chat — hébergé sur Render (région Frankfurt)" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#5B6075;strokeWidth=1.5;html=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontSize=13;fontStyle=1;fontColor=#1B1D29;container=0;" vertex="1" parent="1"><mxGeometry x="110" y="330" width="930" height="640" as="geometry"/></mxCell><mxCell id="k22" value="&lt;b style='font-size:15px'&gt;Apprenant de Kadea Academy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Personne]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Utilise Kadea Chat sur ordinateur ou téléphone.&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="320" height="150" as="geometry"/></mxCell><mxCell id="k23" value="&lt;b style='font-size:15px'&gt;Navigateur web&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Conteneur : HTML, CSS, Alpine.js, client Transmit]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Affiche les pages, envoie les messages sans recharger et écoute son canal temps réel users/&amp;lt;id&amp;gt;.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="420" width="290" height="200" as="geometry"/></mxCell><mxCell id="k24" value="&lt;b style='font-size:15px'&gt;Application web&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Conteneur : AdonisJS 7, Node.js 24, Edge]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Authentification, discussions, groupes, contrôle d'accès, temps réel (Transmit), photos. Render, plan Starter.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="410" width="340" height="220" as="geometry"/></mxCell><mxCell id="k25" value="&lt;b style='font-size:15px'&gt;Base de données&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Conteneur : base de données : PostgreSQL 18]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Comptes, liens e-mail, discussions, membres, messages, blocages, photos. Render, plan Free.&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="730" width="340" height="200" as="geometry"/></mxCell><mxCell id="k26" value="&lt;b style='font-size:15px'&gt;Brevo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Système externe]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Envoi des e-mails transactionnels.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="430" width="300" height="170" as="geometry"/></mxCell><mxCell id="k27" value="&lt;b style='font-size:15px'&gt;Boîte mail de l'utilisateur&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Système externe]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Reçoit les liens de confirmation et de réinitialisation.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="300" height="150" as="geometry"/></mxCell><mxCell id="k28" value="Utilise&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k22" target="k23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k29" value="Pages, formulaires, recherche, photos&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS · JSON]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.32;entryDx=0;entryDy=0;" edge="1" parent="1" source="k23" target="k24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k30" value="Événements temps réel&lt;br&gt;&lt;span style='font-size:10px'&gt;[SSE · /__transmit/events]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="k24" target="k23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k31" value="Lit et écrit&lt;br&gt;&lt;span style='font-size:10px'&gt;[SQL · Lucid ORM · réseau privé]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k24" target="k25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k32" value="Envoie les e-mails&lt;br&gt;&lt;span style='font-size:10px'&gt;[API HTTPS]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k24" target="k26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k33" value="Délivre&lt;br&gt;&lt;span style='font-size:10px'&gt;[SMTP]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k26" target="k27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k34" value="Ouvre les liens reçus" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k22" target="k27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k35" value="&lt;b&gt;Légende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B1D29;" vertex="1" parent="1"><mxGeometry x="1180" y="800" width="200" height="20" as="geometry"/></mxCell><mxCell id="k36" value="Personne" style="rounded=1;arcSize=20;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="824" width="190" height="22" as="geometry"/></mxCell><mxCell id="k37" value="Système étudié" style="rounded=1;arcSize=20;html=1;fillColor=#F2A541;fontColor=#1B1D29;strokeColor=#C9822A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="850" width="190" height="22" as="geometry"/></mxCell><mxCell id="k38" value="Conteneur" style="rounded=1;arcSize=20;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="876" width="190" height="22" as="geometry"/></mxCell><mxCell id="k39" value="Composant" style="rounded=1;arcSize=20;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="902" width="190" height="22" as="geometry"/></mxCell><mxCell id="k40" value="Externe" style="rounded=1;arcSize=20;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="928" width="190" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="k84" name="3. Composants"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k42" value="Kadea Chat — Niveau 3 : composants de l'application web" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1B1D29;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="32" as="geometry"/></mxCell><mxCell id="k43" value="L'intérieur du conteneur « Application web » (AdonisJS 7). Toutes les requêtes passent par Conversation.visibleTo(user) pour le contrôle d'accès." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6075;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="40" as="geometry"/></mxCell><mxCell id="k44" value="Application web — AdonisJS 7 (conteneur)" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#5B6075;strokeWidth=1.5;html=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontSize=13;fontStyle=1;fontColor=#1B1D29;container=0;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="1050" height="1030" as="geometry"/></mxCell><mxCell id="k45" value="&lt;b style='font-size:15px'&gt;Navigateur web&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Conteneur : Alpine.js, Transmit]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Pages, formulaires et flux temps réel.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="220" height="170" as="geometry"/></mxCell><mxCell id="k46" value="&lt;b style='font-size:15px'&gt;Validateurs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : VineJS]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Vérifient chaque formulaire ; messages d'erreur en français. Utilisés par tous les contrôleurs.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="230" height="160" as="geometry"/></mxCell><mxCell id="k47" value="&lt;b style='font-size:15px'&gt;Routes et middlewares&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : start/routes.ts, kernel]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Session, CSRF (Shield), auth / guest, identifiants numériques uniquement.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="230" height="170" as="geometry"/></mxCell><mxCell id="k48" value="&lt;b style='font-size:15px'&gt;Vues&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : Edge]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Pages, morceaux de page (liste, message) et composants. Rendues par les contrôleurs.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="760" width="230" height="160" as="geometry"/></mxCell><mxCell id="k49" value="&lt;b style='font-size:15px'&gt;Authentification&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : NewAccount, Session, EmailVerification, PasswordReset]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Inscription, connexion, confirmation, mot de passe oublié.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="250" height="150" as="geometry"/></mxCell><mxCell id="k50" value="&lt;b style='font-size:15px'&gt;Discussions et messages&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : Conversations, Messages, Users]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Liste, discussion privée, envoi, recherche de personnes.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="250" height="150" as="geometry"/></mxCell><mxCell id="k51" value="&lt;b style='font-size:15px'&gt;Groupes&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : GroupsController]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Création, infos, photo, membres (admins), départ.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="250" height="140" as="geometry"/></mxCell><mxCell id="k52" value="&lt;b style='font-size:15px'&gt;Profil et blocage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : Profile, Blocks]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Nom, photo, mot de passe, bloquer / débloquer.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="760" width="250" height="140" as="geometry"/></mxCell><mxCell id="k53" value="&lt;b style='font-size:15px'&gt;Liens et e-mails&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : UserTokenService, AuthMailService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Jetons hachés (SHA-256), à usage unique ; e-mails de confirmation et de réinitialisation.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="140" width="290" height="140" as="geometry"/></mxCell><mxCell id="k54" value="&lt;b style='font-size:15px'&gt;Présentation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : ConversationListService, MessageThreadService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Aperçus, non-lus, accusés de lecture, messages rangés par jour.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="290" height="130" as="geometry"/></mxCell><mxCell id="k55" value="&lt;b style='font-size:15px'&gt;Temps réel&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : RealtimeService, start/transmit.ts]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Prévient chaque membre sur son canal privé users/&amp;lt;id&amp;gt;.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="450" width="290" height="130" as="geometry"/></mxCell><mxCell id="k56" value="&lt;b style='font-size:15px'&gt;Règles de blocage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : BlockService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Blocage discret : messages non remis, profil masqué.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="600" width="290" height="130" as="geometry"/></mxCell><mxCell id="k57" value="&lt;b style='font-size:15px'&gt;Photos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : services/avatar.ts]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Enregistre et relit les photos dans la table avatars.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="290" height="130" as="geometry"/></mxCell><mxCell id="k58" value="&lt;b style='font-size:15px'&gt;Modèles&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Composant : Lucid ORM]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;User, UserToken, Conversation, ConversationMember, Message, Block.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2545;strokeColor=#78A8D8;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="960" width="250" height="140" as="geometry"/></mxCell><mxCell id="k59" value="&lt;b style='font-size:15px'&gt;Base de données&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Conteneur : base de données : PostgreSQL 18]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;7 tables, dont avatars.&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="930" width="210" height="170" as="geometry"/></mxCell><mxCell id="k60" value="&lt;b style='font-size:15px'&gt;Brevo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Système externe]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;E-mails transactionnels.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C99;fontColor=#FFFFFF;strokeColor=#6E6E7A;align=center;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="135" width="210" height="150" as="geometry"/></mxCell><mxCell id="k61" value="Requêtes&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS]&lt;/span&gt;" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k45" target="k47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k62" value="appelle" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="k47" target="k49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k63" value="appelle" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="k47" target="k50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k64" value="appelle" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="k47" target="k51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k65" value="appelle" style="html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#5B6075;strokeWidth=1.4;fontSize=11;fontColor=#1B1D29;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" 