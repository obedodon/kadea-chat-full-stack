{{-- Un message (écran 07). Variable : message (voir MessageThreadService.present) --}}
@if(message.deleted)
  <p class="kc-msg kc-msg--deleted {{ message.mine ? 'kc-msg--mine' : '' }}" data-message-id="{{ message.id }}">
    @svg('lucide:ban', { width: 18, height: 18 })
    Ce message a été supprimé
  </p>
@else
  <div
    class="kc-msg {{ message.mine ? 'kc-msg--mine' : '' }} {{ message.read ? 'is-read' : '' }}"
    data-message-id="{{ message.id }}"
    data-day-label="{{ message.dayLabel }}"
    data-sent-at="{{ message.sentAt }}"
  >
    @if(message.senderName)
      <p class="kc-msg__author">{{ message.senderName }}</p>
    @end
    <p class="kc-msg__body">{{ message.body }}</p>
    <span class="kc-msg__meta">
      {{ message.time }}
      @if(message.mine)
        <span class="kc-tick" title="{{ message.read ? 'Lu' : 'Envoyé' }}">
          @svg('lucide:check-check', { width: 16, height: 16 })
        </span>
      @end
    </span>
  </div>
@end
