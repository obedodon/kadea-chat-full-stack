@layouts.chat({ title: 'Ton profil — Kadea Chat', conversations, open: true })
  <header class="kc-main__bar kc-thread__head">
    <a href="{{ route('conversations.index') }}" class="kc-icon-btn kc-back" aria-label="Retour aux discussions">
      @svg('lucide:arrow-left', { width: 22, height: 22 })
    </a>
    @!kcAvatar({ name: profile.fullName, url: profile.avatarUrl, initials: profile.initials, tone: profile.tone, size: 'md' })
    <div class="kc-thread__who">
      <h1 class="kc-thread__title">{{ profile.fullName }}</h1>
      <p class="kc-thread__sub">{{ profile.email }}</p>
    </div>
  </header>

  <div class="kc-profile">
    <h2 class="kc-profile__title">Ton profil</h2>
    <p class="kc-profile__sub">Gère tes informations personnelles et la sécurité de ton compte.</p>
    @include('partials/auth_flash')

    {{-- Informations : photo et nom --}}
    <section class="kc-card">
      <span class="kc-card__icon">
        @svg('lucide:user', { width: 26, height: 26 })
      </span>
      <div class="kc-card__body">
        <h3 class="kc-card__title">Informations</h3>
        <p class="kc-card__sub">Ces informations sont visibles par les autres utilisateurs.</p>

        @form({
          route: 'profile.update',
          method: 'POST',
          enctype: 'multipart/form-data',
          class: 'kc-profile__info',
          'x-data': '{ preview: null }',
        })
          <div class="kc-profile__photo">
            <p class="kc-label">Photo de profil</p>
            <label class="kc-photo" title="Changer la photo">
              <span class="kc-avatar kc-avatar--xl kc-avatar--{{ profile.tone }}">
                <img class="kc-avatar__img" x-show="preview" x-bind:src="preview" alt="" />
                @if(profile.avatarUrl)
                  <img class="kc-avatar__img" x-show="!preview" src="{{ profile.avatarUrl }}" alt="" />
                @else
                  <span x-show="!preview">{{ profile.initials }}</span>
                @end
              </span>
              <span class="kc-photo__btn">
                @svg('lucide:camera', { width: 20, height: 20 })
              </span>
              <input
                type="file"
                name="avatar"
                accept="image/png,image/jpeg"
                class="kc-sr"
                x-on:change="preview = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : null"
              />
            </label>
            <p class="kc-hint">JPG ou PNG, 2 Mo maximum.</p>
            @field.root({ name: 'avatar' })
              @!field.error()
            @end
          </div>

          <div class="kc-profile__fields">
            @field.root({ name: 'fullName' })
              @!field.label({ text: 'Nom' })
              @!input.control({ value: profile.fullName, autocomplete: 'name', required: true, maxlength: 100 })
              @!field.error()
            @end
            <div class="field">
              <label class="field__label" for="email">E-mail</label>
              <input id="email" class="field__input kc-input--readonly" type="email" value="{{ profile.email }}" disabled />
              <p class="kc-hint">L'adresse e-mail ne peut pas être modifiée.</p>
            </div>
            <div class="kc-card__actions">
              <button type="submit" class="kc-btn kc-btn--primary kc-btn--sm">Enregistrer</button>
            </div>
          </div>
        @end
      </div>
    </section>

    {{-- Mot de passe : les champs n'apparaissent qu'après le clic (ou s'il y a une erreur à afficher) --}}
    @let(errorsBag = flashMessages.get('inputErrorsBag', {}))
    @let(passwordErrors = !!(errorsBag.currentPassword || errorsBag.password || errorsBag.passwordConfirmation))
    <section class="kc-card" x-data="{ editing: {{ passwordErrors ? 'true' : 'false' }} }">
      <span class="kc-card__icon">
        @svg('lucide:lock', { width: 26, height: 26 })
      </span>
      <div class="kc-card__body">
        <h3 class="kc-card__title">Mot de passe</h3>
        <p class="kc-card__sub">Choisis un mot de passe sécurisé pour protéger ton compte.</p>

        <div class="kc-card__actions" x-show="!editing">
          <button type="button" class="kc-btn kc-btn--outline kc-btn--sm" x-on:click="editing = true">
            Changer le mot de passe
          </button>
        </div>

        @form({ route: 'profile.password', method: 'POST', class: 'kc-profile__password', 'x-show': 'editing', 'x-cloak': true })
          <div class="kc-profile__grid">
            @field.root({ name: 'currentPassword' })
              @!field.label({ text: 'Mot de passe actuel' })
              @!input.password({ autocomplete: 'current-password', placeholder: '••••••••' })
              @!field.error()
            @end
            @field.root({ name: 'password' })
              @!field.label({ text: 'Nouveau mot de passe' })
              @!input.password({ autocomplete: 'new-password', placeholder: '••••••••', hint: '8 caractères minimum' })
              @!field.error()
            @end
            @field.root({ name: 'passwordConfirmation' })
              @!field.label({ text: 'Confirmer le nouveau mot de passe' })
              @!input.password({ autocomplete: 'new-password', placeholder: '••••••••' })
              @!field.error()
            @end
          </div>
          <div class="kc-card__actions">
            <button type="button" class="kc-btn kc-btn--outline kc-btn--sm" x-on:click="editing = false">Annuler</button>
            <button type="submit" class="kc-btn kc-btn--primary kc-btn--sm">Enregistrer le mot de passe</button>
          </div>
        @end
      </div>
    </section>

    {{-- Utilisateurs bloqués --}}
    <section class="kc-card">
      <span class="kc-card__icon">
        @svg('lucide:ban', { width: 26, height: 26 })
      </span>
      <div class="kc-card__body">
        <h3 class="kc-card__title">Utilisateurs bloqués</h3>
        <p class="kc-card__sub">Les utilisateurs bloqués ne peuvent plus t'envoyer de messages.</p>
        <ul class="kc-blocked">
          @each(person in blockedUsers)
            <li class="kc-blocked__item">
              @!kcAvatar({ name: person.fullName, url: person.avatarUrl, initials: person.initials, tone: person.tone, size: 'sm' })
              <div class="kc-blocked__text">
                <strong>{{ person.fullName }}</strong>
                <span>Bloqué le {{ person.since }}</span>
              </div>
              @form({ route: 'blocks.destroy', routeParams: { id: person.id }, method: 'POST' })
                <button type="submit" class="kc-btn kc-btn--danger kc-btn--sm">Débloquer</button>
              @end
            </li>
          @else
            <li class="kc-blocked__empty">Tu n'as bloqué personne.</li>
          @end
        </ul>
      </div>
    </section>

    <div class="kc-profile__logout">
      @form({ route: 'session.destroy', method: 'POST' })
        <button type="submit" class="kc-btn kc-btn--danger kc-btn--sm">
          @svg('lucide:log-out', { width: 18, height: 18 })
          Se déconnecter
        </button>
      @end
    </div>
  </div>
@end
