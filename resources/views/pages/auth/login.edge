@layouts.auth({ title: 'Connexion — Kadea Chat' })
  <h1 class="auth__title">Content de te revoir</h1>
  <p class="auth__sub">Connecte-toi pour reprendre tes discussions.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'grace@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.password({
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    <p style="margin: -4px 0 0; text-align: right;">
      @link({ route: 'password.forgot', class: 'il' })
        Mot de passe oublié ?
      @end
    </p>
    @!button({
      text: 'Connexion',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Connexion…' : 'Connexion'",
    })
  @end

  <p class="auth__foot">
    Pas encore de compte ?
    @link({ route: 'new_account.create', class: 'il' })
      Créer un compte
    @end
  </p>
@end
