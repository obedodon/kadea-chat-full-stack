@layouts.auth({ title: 'Connexion — Kadea Chat' })
  <h1 class="kc-title">Content de te revoir</h1>
  <p class="kc-sub">Connecte-toi pour reprendre tes discussions.</p>
  @include('partials/auth_flash')

  @form({
    route: 'session.store',
    method: 'POST',
    class: 'kc-form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({ type: 'email', autocomplete: 'username', placeholder: 'grace@exemple.com' })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.password({ autocomplete: 'current-password', placeholder: '••••••••' })
      @!field.error()
    @end
    <p style="margin-top: -6px;">
      @link({ route: 'password.forgot', class: 'kc-link kc-link--muted' })
        Mot de passe oublié ?
      @end
    </p>
    @!button({
      text: 'Connexion',
      type: 'submit',
      block: true,
      style: 'margin-top: 6px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Connexion…' : 'Connexion'",
    })
  @end

  <p class="kc-foot">
    Pas encore de compte ?
    @link({ route: 'new_account.create', class: 'kc-link' })
      Créer un compte
    @end
  </p>
@end
