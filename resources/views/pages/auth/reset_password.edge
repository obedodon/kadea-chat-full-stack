@layouts.auth({ title: 'Nouveau mot de passe — Kadea Chat' })
  <h1 class="auth__title">Nouveau mot de passe</h1>
  <p class="auth__sub">Choisis un mot de passe que tu n'utilises pas ailleurs.</p>
  @form({
    route: 'password.update',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    <input type="hidden" name="token" value="{{ token }}" />
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nouveau mot de passe' })
      @!input.password({ autocomplete: 'new-password', placeholder: '8 caractères minimum' })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      @!input.password({ autocomplete: 'new-password', placeholder: 'Retape le mot de passe' })
      @!field.error()
    @end
    @!button({
      text: 'Enregistrer le mot de passe',
      type: 'submit',
      block: true,
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Enregistrement…' : 'Enregistrer le mot de passe'",
    })
  @end
@end
