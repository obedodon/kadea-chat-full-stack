{{-- Champ mot de passe avec bouton « œil » et, si on passe hint, l'aide « 8 caractères minimum » qui devient verte --}}
<div x-data="{ visible: false, value: '' }">
  <div class="kc-pw__box">
    @!input.control({
      ...$props.except(['hint']).all(),
      type: 'password',
      'x-bind:type': "visible ? 'text' : 'password'",
      'x-on:input': 'value = $event.target.value',
    })
    <button
      type="button"
      class="kc-pw__eye"
      x-on:click="visible = !visible"
      aria-label="Afficher le mot de passe"
      x-bind:aria-label="visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe'"
    >
      <span x-show="!visible">
        @svg('lucide:eye', { width: 20, height: 20 })
      </span>
      <span x-show="visible" x-cloak>
        @svg('lucide:eye-off', { width: 20, height: 20 })
      </span>
    </button>
  </div>
  @if($props.get('hint'))
    <p class="kc-hint" x-bind:class="value.length >= 8 && 'kc-hint--ok'">
      <span>
        @svg('lucide:check', { width: 16, height: 16 })
      </span>
      {{ $props.get('hint') }}
    </p>
  @end
</div>
