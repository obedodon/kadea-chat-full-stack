{{--
  Champ mot de passe avec un bouton « œil » pour afficher ou masquer la saisie.
  S'utilise comme input.control, à l'intérieur d'un @field.root :
    @!input.password({ autocomplete: 'current-password' })
  Alpine.js (déjà chargé par le projet) bascule le type entre password et text.
  Attention : en Edge, une balise comme @svg doit toujours être seule sur sa ligne.
--}}
<div x-data="{ visible: false }" style="position: relative; display: block; width: 100%;">
  @!input.control({
    ...$props.all(),
    type: 'password',
    'x-bind:type': "visible ? 'text' : 'password'",
    style: 'width: 100%; box-sizing: border-box; padding-right: 48px;',
  })
  <button
    type="button"
    x-on:click="visible = !visible"
    x-bind:aria-label="visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe'"
    x-bind:aria-pressed="visible.toString()"
    aria-label="Afficher le mot de passe"
    style="position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; padding: 0; border: 0; background: transparent; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #5B6075;"
  >
    <span x-show="!visible" style="display: flex;">
      @svg('lucide:eye', { width: 18, height: 18 })
    </span>
    <span x-show="visible" x-cloak style="display: flex;">
      @svg('lucide:eye-off', { width: 18, height: 18 })
    </span>
  </button>
</div>
