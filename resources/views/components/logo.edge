{{--
  Logo KADEA CHAT.
  onDark: true → toujours la version au texte blanc (fond sombre fixe, ex. panneau de connexion).
  Sinon        → le logo suit le thème : texte noir en clair, texte blanc en sombre.
  Le triangle garde ses couleurs dans les deux cas.
--}}
@let(height = $props.get('height', $props.get('size', 32)))
@link({
  route: 'home',
  'aria-label': 'Kadea Chat — accueil',
  class: 'kc-logo',
  style: 'display: inline-flex;',
})
  @if($props.get('onDark'))
    <img src="/images/logo-dark.png" alt="Kadea Chat" style="height: {{ height }}px; width: auto; display: block;" />
  @else
    <img class="kc-logo__light" src="/images/logo-light.png" alt="Kadea Chat" style="height: {{ height }}px; width: auto;" />
    <img class="kc-logo__dark" src="/images/logo-dark.png" alt="" style="height: {{ height }}px; width: auto;" />
  @end
@end
